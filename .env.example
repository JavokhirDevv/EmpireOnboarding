# Copy this file to .env and fill in real values before running the app.
# Environment variables declared here are NOT automatically loaded by Prisma;
# prisma.config.ts loads them via `import "dotenv/config"`.

DATABASE_URL="file:./dev.db"

# Used to sign session cookies (jose/JWT). Generate your own — do not reuse this example.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="replace-with-a-generated-secret"

# Default admin account created by the seed script (npm run db:seed).
SEED_ADMIN_EMAIL="admin@empirenational.com"
SEED_ADMIN_PASSWORD="choose-a-strong-password"
